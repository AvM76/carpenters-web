---
import { Image } from 'astro:assets';
import { featuredPhoto, workSections } from '../photos';

/* The work stream: one large featured photo, a row of jump buttons, then a
   gallery per folder in src/assets/work/. Adding a photo or a whole section
   is just a matter of adding files/folders — see src/photos.ts. */
---

{
  featuredPhoto && (
    <div class="feature reveal">
      <Image
        src={featuredPhoto}
        alt="Finished piece by AVM Timber Design"
        widths={[768, 1280, 1920]}
        sizes="100vw"
      />
    </div>
  )
}

<nav class="jump" aria-label="Jump to a section">
  {
    workSections.map((s) => (
      <a href={`#${s.id}`}>
        {s.title}
        <span class="n">{s.photos.length}</span>
      </a>
    ))
  }
</nav>

{
  workSections.map((s) => (
    <section class="work-sec" id={s.id}>
      <h3 class="reveal">{s.title}</h3>
      <div class="masonry">
        {s.photos.map((img) => (
          <figure class="reveal">
            <Image
              src={img}
              alt={`${s.title} by AVM Timber Design`}
              widths={[400, 700, 1000]}
              sizes="(max-width: 560px) 100vw, (max-width: 820px) 50vw, 33vw"
              loading="lazy"
            />
          </figure>
        ))}
      </div>
    </section>
  ))
}
